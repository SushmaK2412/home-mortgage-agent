# --- FRED (required for rates dashboard and chart) ---
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# IANA timezone for the 09:00 daily benchmark snapshot job
SCHEDULE_TZ=America/New_York

# Optional SQLite path (default: data/mortgage_rates.db)
# DATABASE_PATH=data/mortgage_rates.db

# --- LLM assistant (/assistant) — OpenAI by default, any compatible /v1/chat/completions host ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model (default in code: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1
