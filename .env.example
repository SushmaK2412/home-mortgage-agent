# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# IANA timezone for the 9:00 daily job
SCHEDULE_TZ=America/New_York

# OpenAI — required for /assistant (first-time buyer chat). Not needed for rates page only.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: model id (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional: use a compatible OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
